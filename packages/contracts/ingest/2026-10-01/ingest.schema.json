{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manager.example.com/contracts/ingest/2026-10-01/ingest.schema.json",
  "title": "Manager Ingest Contract 2026-10-01",
  "description": "Body schema cho /v1/integrations/snapshots*. Giá trị metric luôn là GIÁ TRỊ TUYỆT ĐỐI tại observed_at, không phải số gia. null = chưa thu thập, 0 = đã thu thập và bằng 0.",
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "externalId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "name": { "type": "string", "maxLength": 100 }
      }
    },
    "metricValue": { "type": ["integer", "null"], "minimum": 0 },
    "metrics": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/metricValue" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "type": "object" }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": { "type": "integer", "minimum": 0 },
        "content": { "type": "integer", "minimum": 0 },
        "metrics": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 }
      }
    },

    "SnapshotCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "snapshot_type", "observed_at", "report_timezone", "expected_counts"],
      "properties": {
        "platform": { "$ref": "#/$defs/key" },
        "snapshot_type": { "enum": ["full", "delta"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "report_timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "scope": {
          "type": "object",
          "description": "Chỉ có nghĩa khi snapshot_type=full. Mỗi mục khai báo 'tập này ĐẦY ĐỦ'. Bản ghi thuộc phạm vi nhưng vắng mặt sẽ bị đánh dấu removed sau commit thành công.",
          "additionalProperties": false,
          "properties": {
            "resources": { "type": "boolean" },
            "content_window": { "$ref": "#/$defs/window" },
            "metrics_window": { "$ref": "#/$defs/window" },
            "events_window": { "$ref": "#/$defs/window" }
          }
        },
        "expected_counts": { "$ref": "#/$defs/counts" }
      }
    },

    "ResourceBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["external_id", "resource_type", "observed_at"],
            "properties": {
              "external_id": { "$ref": "#/$defs/externalId" },
              "resource_type": { "$ref": "#/$defs/key" },
              "display_name": { "type": "string", "maxLength": 200 },
              "username": { "type": "string", "maxLength": 200 },
              "url": { "type": "string", "maxLength": 500 },
              "country": { "$ref": "#/$defs/country" },
              "state": { "enum": ["active", "disabled"], "default": "active" },
              "managed": { "type": "boolean" },
              "active": { "type": "boolean" },
              "projects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["project_key", "enabled"],
                  "properties": {
                    "project_key": { "$ref": "#/$defs/key" },
                    "enabled": { "type": "boolean" }
                  }
                }
              },
              "observed_at": { "$ref": "#/$defs/timestamp" },
              "extensions": { "$ref": "#/$defs/extensions" }
            }
          }
        }
      }
    },

    "ContentBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["external_id", "resource_external_id", "published_date", "metrics", "observed_at"],
            "properties": {
              "external_id": { "$ref": "#/$defs/externalId" },
              "resource_external_id": { "$ref": "#/$defs/externalId" },
              "published_date": { "$ref": "#/$defs/date" },
              "published_at": { "$ref": "#/$defs/timestamp" },
              "url": { "type": "string", "maxLength": 500 },
              "state": { "enum": ["active", "deleted"], "default": "active" },
              "metrics": { "$ref": "#/$defs/metrics" },
              "observed_at": { "$ref": "#/$defs/timestamp" },
              "extensions": { "$ref": "#/$defs/extensions" }
            }
          }
        }
      }
    },

    "MetricsBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource_external_id", "date", "metrics", "observed_at"],
            "properties": {
              "resource_external_id": { "$ref": "#/$defs/externalId" },
              "date": { "$ref": "#/$defs/date" },
              "metrics": { "$ref": "#/$defs/metrics" },
              "observed_at": { "$ref": "#/$defs/timestamp" },
              "extensions": { "$ref": "#/$defs/extensions" }
            }
          }
        }
      }
    },

    "EventBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["external_id", "resource_external_id", "kind", "occurred_date"],
            "properties": {
              "external_id": { "$ref": "#/$defs/externalId" },
              "resource_external_id": { "$ref": "#/$defs/externalId" },
              "kind": { "$ref": "#/$defs/key" },
              "occurred_date": { "$ref": "#/$defs/date" },
              "occurred_at": { "$ref": "#/$defs/timestamp" },
              "project_key": { "$ref": "#/$defs/key" },
              "extensions": { "$ref": "#/$defs/extensions" }
            }
          }
        }
      }
    },

    "CommitRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accept_partial": {
          "type": "boolean",
          "default": false,
          "description": "false (mặc định): còn bản ghi bị từ chối thì KHÔNG commit. true: commit phần hợp lệ, phần bị từ chối vẫn hiện trong khung chất lượng dữ liệu."
        }
      }
    },

    "BatchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["received", "created", "updated", "unchanged", "stale_ignored", "rejected", "rejections"],
      "properties": {
        "received": { "type": "integer", "minimum": 0 },
        "created": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "stale_ignored": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "code"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "external_id": { "type": "string" },
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },

    "CommitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "status", "totals", "as_of"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "status": { "enum": ["committed"] },
        "totals": { "$ref": "#/$defs/counts" },
        "removed": { "$ref": "#/$defs/counts" },
        "rejected_total": { "type": "integer", "minimum": 0 },
        "as_of": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
