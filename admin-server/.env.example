# ════════════════════════════════════════════════════════════════════════
#  admin-server/.env — CẤU HÌNH ADMIN WEB SERVER.  Copy -> admin-server/.env
#  (Tool có file RIÊNG ở repo root: .env)
#
#  Copy file này -> admin-server/.env rồi sửa DATA_DIR + JWT_SECRET. Sinh JWT:
#       python -c "import secrets; print(secrets.token_hex(32))"
# ════════════════════════════════════════════════════════════════════════

# DEV: admin đọc THẲNG folder JSON của Tool (LocalFileDb), auth ở file sqlite bền.
MODE=dev

# Thư mục data của Tool — PHẢI GIỐNG APP_DATA_DIR bên .env của Tool.
DATA_DIR=C:/Users/Admin/AppData/Roaming/fb-uploader-ui/data

# file:/// = LocalFileDb (đọc folder DATA_DIR). Tài khoản (accounts) nằm ở
# admin-server/admin-auth.db (đường tương đối theo thư mục admin-server/).
DATABASE_URL=file:///./admin-auth.db

# Khoá ký JWT — sinh mới: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_64

ADMIN_PORT=8421
ADMIN_WEB_DIR=

# ── PRODUCTION (khi mang qua VPS) — đổi 2 dòng thành: ──
#     MODE=production
#     DATABASE_URL=postgresql://ufsync:MAT_KHAU@127.0.0.1:5432/ufsync
#  rồi: python create_admin.py   (tạo lại tài khoản admin trên Postgres, cùng user/mật khẩu)

# ── Cache Redis (tuỳ chọn) ────────────────────────────────────────────────
# Bỏ trống REDIS_URL hoặc CACHE_ENABLED=0 → chạy không cache, đọc thẳng CSDL như trước.
# VPS production: Redis đang chạy ở cổng 6380 (xem server/DEPLOY.md).
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_ENABLED=1
# Kết quả tổng hợp sống tối đa bao lâu trong Redis (giây).
CACHE_TTL=3600
# Cửa sổ làm mới con dấu phiên bản (giây) — CHÍNH LÀ độ trễ tối đa của số liệu.
CACHE_VERSION_TTL=300
