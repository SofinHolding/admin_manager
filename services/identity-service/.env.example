# identity-service — biến môi trường RIÊNG của service (không dùng chung file .env với service khác)
IDENTITY_PORT=8430
IDENTITY_LOG_LEVEL=INFO
# Database RIÊNG. Mỗi service có user và mật khẩu riêng, chỉ có quyền trên identity_db.
IDENTITY_DATABASE_URL=postgresql://identity_svc:CHANGE_ME@127.0.0.1:5432/identity_db

# ── Khoá ký token (RS256/JWKS) ── sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_ENV=dev
IDENTITY_ISSUER=http://127.0.0.1:8430
IDENTITY_AUDIENCE=manager-api
IDENTITY_KEY_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
IDENTITY_JWKS_GRACE_SECONDS=3600

# ── OIDC / OAuth2 (Phase 1.6) ──
# Client first-party `manager-web` (public, PKCE): python -m identity_service.oidc_clients seed-dev
# Chỉ redirect URI liệt kê ở đây (CSV) mới được chấp nhận; so khớp CHÍNH XÁC, không wildcard.
IDENTITY_WEB_REDIRECT_URIS=http://127.0.0.1:5174/admin/callback
IDENTITY_WEB_POST_LOGOUT_URIS=
IDENTITY_SSO_TTL_S=28800
IDENTITY_AUTH_CODE_TTL_S=60
# Back-channel logout: chỉ https (hoặc http loopback ở dev/test); cấm link-local/metadata; không theo redirect.
IDENTITY_BACKCHANNEL_ENABLED=true
IDENTITY_BACKCHANNEL_TIMEOUT_S=5
IDENTITY_BACKCHANNEL_MAX_ATTEMPTS=6
IDENTITY_BACKCHANNEL_ALLOW_PRIVATE=false

# ── Feed nội bộ (đọc bởi service khác: analytics, integration, reward) ──
# IDENTITY_FEED_KEY_<READER>=<khoá ngẫu nhiên >= 24 ký tự, mỗi bên đọc một khoá>
