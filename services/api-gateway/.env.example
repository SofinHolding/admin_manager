# api-gateway — biến môi trường RIÊNG của service. KHÔNG chứa secret (gateway không giữ secret nghiệp vụ).
# Tiền tố GATEWAY_* (khuyến nghị); API_GATEWAY_* vẫn được chấp nhận cho PORT / LOG_LEVEL.
API_GATEWAY_PORT=8400
API_GATEWAY_LOG_LEVEL=INFO

# dev | production. production bật HSTS (gateway luôn đứng sau TLS ở nginx).
GATEWAY_ENV=dev

# CORS allowlist: origin CHÍNH XÁC, phân tách bằng dấu phẩy. Không dùng '*'. Rỗng = không cho cross-origin.
GATEWAY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GATEWAY_CORS_ALLOW_CREDENTIALS=false

# Giới hạn (chống lạm dụng ở biên). Vượt body => 413 ngay khi đọc stream.
GATEWAY_MAX_BODY_BYTES=2097152
GATEWAY_MAX_HEADER_BYTES=16384
GATEWAY_MAX_HEADER_COUNT=100
GATEWAY_MAX_URL_BYTES=8192

# Upstream (mặc định lấy cổng từ infra/service-registry.json). Chỉ http(s)://host[:port], không có đường dẫn.
GATEWAY_UPSTREAM_IDENTITY=http://127.0.0.1:8430
GATEWAY_UPSTREAM_INTEGRATION=http://127.0.0.1:8431
GATEWAY_UPSTREAM_ANALYTICS=http://127.0.0.1:8432
GATEWAY_UPSTREAM_REWARD=http://127.0.0.1:8422

# Timeout (giây) và circuit breaker.
GATEWAY_CONNECT_TIMEOUT_S=2
GATEWAY_READ_TIMEOUT_S=30
GATEWAY_BODY_TIMEOUT_S=30
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_COOLDOWN_S=10

# Rate limit nền theo IP + nhóm route (KHÔNG thay rate limit của service). Số request/phút.
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_STRICT_PER_MIN=10
GATEWAY_RATE_LIMIT_AUTH_PER_MIN=60
GATEWAY_RATE_LIMIT_DEFAULT_PER_MIN=600

# IP/CIDR của reverse proxy tin cậy (nginx cùng máy) — chỉ khi peer thuộc danh sách này mới tin X-Real-IP.
# Mặc định rỗng: IP client = địa chỉ peer TCP, mọi X-Real-IP/X-Forwarded-* của client bị bỏ.
GATEWAY_TRUSTED_PROXIES=

# (tuỳ chọn) đường dẫn nguồn route; mặc định tự tìm infra/ trong repo hoặc /app/infra trong image.
# GATEWAY_ROUTE_MAP_PATH=
# GATEWAY_REGISTRY_PATH=
