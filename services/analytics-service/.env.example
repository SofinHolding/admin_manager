# analytics-service — biến môi trường RIÊNG của service (không dùng chung file .env với service khác)
ANALYTICS_PORT=8432
ANALYTICS_LOG_LEVEL=INFO
# Database RIÊNG. Mỗi service có user và mật khẩu riêng, chỉ có quyền trên analytics_db.
ANALYTICS_DATABASE_URL=postgresql://analytics_svc:CHANGE_ME@127.0.0.1:5432/analytics_db
ANALYTICS_REDIS_URL=redis://127.0.0.1:6379/0  # cache thuần; ACL user riêng
