# analytics-service — biến môi trường RIÊNG của service (không dùng chung file .env với service khác)
# KHÔNG đặt secret thật ở đây. Giá trị dev sinh bởi `python infra/scripts/bootstrap_dev.py` (file .env.dev, gitignored).
ANALYTICS_PORT=8432
ANALYTICS_LOG_LEVEL=INFO

# Database RIÊNG. Mỗi service có user và mật khẩu riêng, chỉ có quyền trên analytics_db. (BẮT BUỘC)
ANALYTICS_DATABASE_URL=postgresql://analytics_svc:CHANGE_ME@127.0.0.1:5432/analytics_db

# Cache thuần, TUỲ CHỌN (bỏ trống = đọc thẳng PostgreSQL). ACL user riêng `analytics_cache`, prefix `analytics:*`.
ANALYTICS_REDIS_URL=redis://analytics_cache:CHANGE_ME@127.0.0.1:6379/0
ANALYTICS_CACHE_TTL_S=300

# Xác thực user: token RS256 do Identity ký, verify OFFLINE bằng JWKS.
ANALYTICS_ISSUER=http://127.0.0.1:8430                      # BẮT BUỘC; khớp chính xác claim `iss`
ANALYTICS_AUDIENCE=manager-api
ANALYTICS_IDENTITY_JWKS_URL=http://127.0.0.1:8430/.well-known/jwks.json   # mặc định: {ISSUER}/.well-known/jwks.json

# Nguồn dữ liệu (pull). Thiếu URL/khoá => consumer tắt (service vẫn chạy, dashboard vẫn đọc dữ liệu đã có).
ANALYTICS_INTEGRATION_URL=http://127.0.0.1:8431
ANALYTICS_INTEGRATION_FEED_KEY=CHANGE_ME                     # khoá của cặp Integration -> Analytics (>= 16 ký tự)
ANALYTICS_IDENTITY_URL=http://127.0.0.1:8430
ANALYTICS_IDENTITY_FEED_KEY=CHANGE_ME

# Tinh chỉnh
ANALYTICS_STALE_AFTER_S=3600        # lag lớn hơn mức này => freshness.stale=true
ANALYTICS_SYNC_INTERVAL_S=5         # chu kỳ đồng bộ nền
ANALYTICS_CONSUMER_MAX_ATTEMPTS=3   # retry có giới hạn trước khi vào dead_letters
ANALYTICS_CONSUMER_BACKOFF_BASE_S=0.5
