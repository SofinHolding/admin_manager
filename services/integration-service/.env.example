# integration-service — biến môi trường RIÊNG của service (không dùng chung file .env với service khác).
# KHÔNG đặt secret thật vào file này. Giá trị CHANGE_ME / <...> là chỗ giữ chỗ; secret DEV do infra/scripts/bootstrap_dev.py sinh ngẫu nhiên.

INTEGRATION_PORT=8431
INTEGRATION_LOG_LEVEL=INFO
# dev | test | production (production bắt buộc issuer và JWKS dùng https)
INTEGRATION_ENV=dev

# Database RIÊNG. Mỗi service có user và mật khẩu riêng, chỉ có quyền trên integration_db.
INTEGRATION_DATABASE_URL=postgresql://integration_svc:CHANGE_ME@127.0.0.1:5432/integration_db

# Xác thực người dùng: token RS256 do Identity ký, verify OFFLINE bằng JWKS (không có secret chung).
INTEGRATION_ISSUER=http://127.0.0.1:8430
INTEGRATION_AUDIENCE=manager-api
INTEGRATION_IDENTITY_JWKS_URL=http://127.0.0.1:8430/.well-known/jwks.json

# Khoá đọc feed/canonical của từng bên đọc (X-Service-Key, >= 24 ký tự, mỗi bên một khoá). Thiếu => /internal/* từ chối tất cả.
# INTEGRATION_FEED_KEY_ANALYTICS=<khoá ngẫu nhiên>
# INTEGRATION_FEED_KEY_IDENTITY=<khoá ngẫu nhiên>

# Consumer provisioning (kéo feed của Identity). Thiếu URL hoặc khoá => consumer TẮT, service vẫn chạy.
# INTEGRATION_IDENTITY_FEED_URL=http://127.0.0.1:8430
# INTEGRATION_IDENTITY_FEED_KEY=<khoá ngẫu nhiên>
# INTEGRATION_PROVISIONING_POLL_S=5
# INTEGRATION_PROVISIONING_MAX_ATTEMPTS=5

# Giới hạn (giá trị mặc định ghi sẵn)
# INTEGRATION_RATE_LIMIT_PER_MIN=600
# INTEGRATION_SNAPSHOT_TTL_S=21600
# INTEGRATION_MAX_BODY_BYTES=2097152
# INTEGRATION_MAX_CLIENTS_PER_OWNER=20
# INTEGRATION_MAX_CREDENTIALS_PER_CLIENT=10
# INTEGRATION_CREDENTIAL_DEFAULT_TTL_DAYS=0
# INTEGRATION_MAINTENANCE_INTERVAL_S=60

# Jobs (Fallback Tool) và pairing legacy (giá trị mặc định ghi sẵn)
# INTEGRATION_JOB_LEASE_DEFAULT_S=300
# INTEGRATION_JOB_LEASE_MAX_S=900
# INTEGRATION_JOB_MAX_ATTEMPTS=3
# INTEGRATION_JOB_BACKOFF_BASE_S=30
# INTEGRATION_JOB_BACKOFF_MAX_S=900
# INTEGRATION_JOB_MAX_PENDING_PER_OWNER=1000
# INTEGRATION_LEGACY_REDEEM_PER_WINDOW=10
# INTEGRATION_LEGACY_REDEEM_WINDOW_S=300
