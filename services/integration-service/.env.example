# integration-service — biến môi trường RIÊNG của service (không dùng chung file .env với service khác)
INTEGRATION_PORT=8431
INTEGRATION_LOG_LEVEL=INFO
# Database RIÊNG. Mỗi service có user và mật khẩu riêng, chỉ có quyền trên integration_db.
INTEGRATION_DATABASE_URL=postgresql://integration_svc:CHANGE_ME@127.0.0.1:5432/integration_db
