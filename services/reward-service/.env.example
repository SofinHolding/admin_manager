# reward-service — bản mẫu .env (chmod 600 khi triển khai thật, KHÔNG commit .env thật).
# Copy file này thành `.env` rồi điền giá trị thật — KHÔNG sửa `.env.example` để chứa bí mật thật.
# Phase 4: KHÔNG còn JWT_SECRET dùng chung / ADMIN_API_BASE. Reward verify token RS256 của Identity bằng JWKS.

# ── Database RIÊNG của Reward (user riêng, DB riêng; KHÔNG dùng DB ufsync/identity_db) ──
# Mật khẩu để placeholder; giá trị thật do hạ tầng cấp (DEV: infra/scripts/bootstrap_dev.py → .env.dev).
REWARD_DATABASE_URL=postgresql://reward_svc:<mat-khau-reward_svc>@127.0.0.1:55440/reward_db

# ── Identity: xác thực + quyền (API công khai) ──
REWARD_IDENTITY_URL=http://127.0.0.1:8430
# Mặc định: ${REWARD_IDENTITY_URL}/.well-known/jwks.json
REWARD_IDENTITY_JWKS_URL=http://127.0.0.1:8430/.well-known/jwks.json
# Phải KHỚP CHÍNH XÁC claim `iss` / `aud` do Identity phát hành.
REWARD_ISSUER=http://127.0.0.1:8430
REWARD_AUDIENCE=manager-api
# Outbound tới Identity: timeout ngắn + retry/backoff có giới hạn.
REWARD_IDENTITY_TIMEOUT_S=5
REWARD_IDENTITY_RETRIES=2
REWARD_IDENTITY_BACKOFF_S=0.3

# ── Feed sự kiện của Identity (thu quyền/khoá/xoá/thu hồi phiên có hiệu lực ngay) ──
# Thiếu KEY ⇒ consumer TẮT (service vẫn chạy nhưng thu quyền chỉ có hiệu lực khi access token hết hạn).
REWARD_IDENTITY_FEED_URL=http://127.0.0.1:8430
REWARD_IDENTITY_FEED_KEY=<khoa-feed-do-bootstrap-cap>
REWARD_FEED_POLL_INTERVAL_S=2
REWARD_FEED_BATCH_SIZE=100
REWARD_FEED_EVENT_MAX_ATTEMPTS=4

# ── Riêng reward-service ──────────────────────────────────────────
REWARD_PORT=8422
REWARD_TOKEN_KEY=<Fernet.generate_key() — 44 ky tu base64, KHONG DUOC MAT>
REWARD_DB_MIGRATE_ON_BOOT=1
REWARD_MAX_CONCURRENT_JOBS=3
REWARD_HTTP_TIMEOUT_S=15
REWARD_CONFIRM_TIMEOUT_S=15
REWARD_CONFIRM_POLL_INTERVAL_S=2
REWARD_UNKNOWN_PAUSE_THRESHOLD=5
REWARD_RECONCILE_GRACE_S=45
REWARD_API_BASE=https://discord.com/api/v9
REWARD_GATEWAY_URL=wss://gateway.discord.gg/?v=9&encoding=json
REWARD_CORS_ORIGINS=http://localhost:5175
LOG_LEVEL=INFO
