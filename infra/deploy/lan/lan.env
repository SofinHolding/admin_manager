# Giá trị KHÔNG bí mật cho máy chủ LAN (secret nằm trong .env.dev sinh bởi bootstrap_dev.py).
# Dùng: docker compose --env-file .env.dev --env-file infra/deploy/lan/lan.env -f infra/compose/stack.yml up -d
# Địa chỉ công khai Tool/người dùng gọi (qua Cloudflare Tunnel -> http://192.168.1.70:8480).
INTEGRATION_PUBLIC_BASE_URL=https://statsdash.dnlabs.space
# CIDR network Docker của nginx (mp-web) đứng trước gateway, để rate limit thấy IP thật.
GATEWAY_TRUSTED_PROXIES=172.16.0.0/12
