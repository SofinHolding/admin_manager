# admin-web — biến build-time. TẤT CẢ biến VITE_* được NHÚNG VÀO BUNDLE công khai:
# KHÔNG BAO GIỜ đặt secret, API key máy (mpk_...), client secret hay mật khẩu ở đây.
# Sao chép thành `.env.local` (đã gitignore) khi cần ghi đè.

# Chế độ đăng nhập: password (mặc định, POST /v1/auth/login) | oidc (Authorization Code + PKCE)
VITE_AUTH_MODE=password

# --- Chỉ dùng khi VITE_AUTH_MODE=oidc (client PUBLIC `manager-web`, không có secret) ---
VITE_OIDC_CLIENT_ID=manager-web
# Phải khớp CHÍNH XÁC redirect URI đã đăng ký trong Identity. Mặc định: <origin>/admin/callback
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5174/admin/callback
VITE_OIDC_SCOPE=openid profile email
# Endpoint đi qua API Gateway cùng origin (mặc định như dưới)
# VITE_OIDC_AUTHORIZE_URL=/oauth/authorize
# VITE_OIDC_TOKEN_URL=/oauth/token
# VITE_OIDC_LOGOUT_URL=/oauth/logout
# Nếu đặt, id_token.iss phải khớp
# VITE_OIDC_ISSUER=http://127.0.0.1:8430

# --- Chỉ dùng cho dev server (KHÔNG có tiền tố VITE_ nên không vào bundle) ---
# API Gateway mà `vite` proxy tới: /v1, /oauth, /.well-known
DEV_GATEWAY_URL=http://127.0.0.1:8400
