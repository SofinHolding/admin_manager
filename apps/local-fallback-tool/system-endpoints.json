{
  "format": "manager-tool-endpoints/1",
  "default_gateway": "http://192.168.1.70:8480",
  "note": "Nguồn sự thật DUY NHẤT về địa chỉ máy chủ nhúng sẵn và các endpoint hệ thống mà tool dùng. system_api.py (Python) và electron/main.cjs đều đọc file này. Danh sách mặt phẳng MÁY phải khớp services/integration-service/src/integration_service/guide/catalog.py (tests/test_system_api.py kiểm).",
  "endpoints": [
    {"name": "health", "method": "GET", "path": "/v1/health", "scope": null, "auth": false, "probe": "safe",
     "summary": "Gateway còn sống (không cần key)"},
    {"name": "handshake", "method": "POST", "path": "/v1/integrations/handshake", "scope": "integration:handshake", "auth": true, "probe": "safe",
     "summary": "Khai báo thiết bị; lần đầu bind key vào máy này, gọi lại là idempotent"},
    {"name": "platforms", "method": "GET", "path": "/v1/integrations/platforms", "scope": "integration:handshake", "auth": true, "probe": "safe",
     "summary": "Nền tảng + mã key này được gửi dữ liệu"},
    {"name": "resources_list", "method": "GET", "path": "/v1/integrations/resources", "scope": "jobs:claim", "auth": true, "probe": "safe",
     "summary": "Danh sách kênh (key dùng chung thấy mọi owner, lọc owner_account_id)"},
    {"name": "resource_owners", "method": "GET", "path": "/v1/integrations/resource-owners", "scope": "jobs:claim", "auth": true, "probe": "safe",
     "summary": "Danh sách user có kênh"},
    {"name": "resources_batch", "method": "POST", "path": "/v1/integrations/resources/batch", "scope": "resources:write", "auth": true, "probe": "skip",
     "summary": "Upsert kênh hàng loạt (cần X-Delegated-Job)"},
    {"name": "snapshot_create", "method": "POST", "path": "/v1/integrations/snapshots", "scope": "snapshots:write", "auth": true, "probe": "skip",
     "summary": "Tạo snapshot (cần X-Delegated-Job)"},
    {"name": "snapshot_resources", "method": "POST", "path": "/v1/integrations/snapshots/{snapshot_id}/resources", "scope": "snapshots:write", "auth": true, "probe": "skip",
     "summary": "Gửi batch kênh vào snapshot"},
    {"name": "snapshot_content", "method": "POST", "path": "/v1/integrations/snapshots/{snapshot_id}/content", "scope": "snapshots:write", "auth": true, "probe": "skip",
     "summary": "Gửi batch video/bài đăng vào snapshot"},
    {"name": "snapshot_events", "method": "POST", "path": "/v1/integrations/snapshots/{snapshot_id}/events", "scope": "snapshots:write", "auth": true, "probe": "skip",
     "summary": "Gửi batch sự kiện vào snapshot"},
    {"name": "snapshot_metrics", "method": "POST", "path": "/v1/integrations/snapshots/{snapshot_id}/metrics", "scope": "metrics:write", "auth": true, "probe": "skip",
     "summary": "Gửi batch chỉ số kênh vào snapshot"},
    {"name": "snapshot_commit", "method": "POST", "path": "/v1/integrations/snapshots/{snapshot_id}/commit", "scope": "snapshots:write", "auth": true, "probe": "skip",
     "summary": "Commit snapshot"},
    {"name": "snapshot_status", "method": "GET", "path": "/v1/integrations/snapshots/{snapshot_id}", "scope": "snapshots:write", "auth": true, "probe": "skip",
     "summary": "Trạng thái snapshot"},
    {"name": "jobs_claim", "method": "POST", "path": "/v1/integrations/jobs/claim", "scope": "jobs:claim", "auth": true, "probe": "skip",
     "summary": "Nhận job thu thập (đổi trạng thái job nên không dò thử)"},
    {"name": "job_heartbeat", "method": "POST", "path": "/v1/integrations/jobs/{job_id}/heartbeat", "scope": "jobs:claim", "auth": true, "probe": "skip",
     "summary": "Gia hạn lease job"},
    {"name": "job_complete", "method": "POST", "path": "/v1/integrations/jobs/{job_id}/complete", "scope": "jobs:complete", "auth": true, "probe": "skip",
     "summary": "Báo job hoàn thành"},
    {"name": "job_fail", "method": "POST", "path": "/v1/integrations/jobs/{job_id}/fail", "scope": "jobs:complete", "auth": true, "probe": "skip",
     "summary": "Báo job thất bại"},
    {"name": "worker_register", "method": "POST", "path": "/v1/integrations/workers/register", "scope": "jobs:claim", "auth": true, "probe": "safe",
     "summary": "Đăng ký worker (chỉ trong bộ nhớ server)"},
    {"name": "worker_heartbeat", "method": "POST", "path": "/v1/integrations/workers/{worker_id}/heartbeat", "scope": "jobs:claim", "auth": true, "probe": "safe",
     "summary": "Heartbeat worker"}
  ]
}
