{
  "name": "local-ops-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --port 5176\" \"wait-on http://localhost:5176 && electron electron/main.cjs\"",
    "electron:build": "npm run typecheck && vite build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.manager.collector",
    "productName": "Channel Collector",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "dist/**",
      "electron/**",
      "collect.py",
      "channel_collect.py",
      "channels_db.py",
      "system_api.py",
      "pools.py",
      "health.py",
      "tiktok_links.py",
      "video_links.py",
      "checkers/**",
      "requirements.txt",
      "system-endpoints.json"
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
